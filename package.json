{
  "name": "1ctx",
  "version": "0.0.0-dev",
  "description": "One continuous context for agents",
  "type": "module",
  "bin": {
    "1ctx": "./src/server/main.ts"
  },
  "scripts": {
    "start": "bun src/server/main.ts",
    "dev": "ONECTX_DEV=1 bun --watch src/server/main.ts",
    "test": "bun test --concurrent --max-concurrency 4 --timeout 20000 test/",
    "vendor-test": "scripts/vendor-test.sh",
    "lint": "bun biome check --write . && bun check",
    "build": "mkdir -p bin && bun build src/server/main.ts src/server/overview/scan.worker.ts src/server/bash/command.worker.ts src/server/repos/fetch.worker.ts --compile ${TARGET:+--target=$TARGET} --no-compile-autoload-dotenv --no-compile-autoload-bunfig --sourcemap --define \"process.env.ONECTX_BUILD_VERSION=\\\"${VERSION:-}\\\"\" --outfile bin/1ctx && rm -f .*.bun-build",
    "smoke": "scripts/smoke.sh",
    "image": "scripts/image.sh",
    "image-smoke": "scripts/image-smoke.sh",
    "kind-up": "scripts/kind.sh up",
    "kind-image": "scripts/kind.sh image",
    "kind-down": "scripts/kind.sh down",
    "clean": "scripts/preview.sh clean && rm -rf bin .*.bun-build",
    "preview": "scripts/preview.sh restart",
    "preview-stop": "scripts/preview.sh stop",
    "preview-log": "scripts/preview.sh log",
    "preview-clean": "scripts/preview.sh clean",
    "preview-provision": "scripts/preview.sh provision",
    "preview-reset": "scripts/preview.sh reset",
    "staging-deploy": "scripts/staging.sh deploy",
    "staging-provision": "scripts/staging.sh provision",
    "staging-status": "scripts/staging.sh status",
    "load-db": "bun scripts/load/db/build.ts",
    "load-bench": "bun scripts/load/bench.ts",
    "load-cluster": "bun scripts/load/cluster.ts",
    "load-summary": "bun scripts/load/summarize.ts",
    "load-smoke": "bun scripts/load/bench.ts --smoke",
    "models": "bun scripts/models.ts && bun biome format --write src/server/providers/models.json"
  },
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.1",
    "@mongodb-js/zstd": "7.0.0",
    "@preact/signals": "2.11.3",
    "@types/bun": "1.4.2",
    "@types/ini": "4.1.1",
    "@types/papaparse": "5.5.2",
    "@types/sprintf-js": "1.1.4",
    "@types/turndown": "5.0.6",
    "@zip.js/zip.js": "2.23.0",
    "fast-xml-parser": "5.11.2",
    "file-type": "21.3.4",
    "gpt-tokenizer": "4.0.0",
    "guarded-fetch": "0.1.3",
    "highlight.js": "11.12.0",
    "idiomorph": "0.8.0",
    "ini": "6.0.0",
    "ipaddr.js": "2.2.0",
    "modern-tar": "0.8.5",
    "node-liblzma": "2.2.0",
    "nodemailer": "10.0.16",
    "papaparse": "5.7.0",
    "preact": "10.29.8",
    "preact-render-to-string": "6.8.0",
    "re2js": "1.4.0",
    "seek-bzip": "2.0.0",
    "smol-toml": "1.9.1",
    "sprintf-js": "1.1.3",
    "turndown": "7.2.4",
    "typescript": "7.0.2",
    "undici": "7.29.0",
    "uplot": "1.6.32",
    "yaml": "2.9.1"
  },
  "patchedDependencies": {
    "modern-tar@0.8.5": "patches/modern-tar@0.8.5.patch",
    "re2js@1.4.0": "patches/re2js@1.4.0.patch"
  }
}
