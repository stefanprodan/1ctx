# Copy to scripts/staging.env (git-ignored) and fill in. Sourced by
# scripts/staging.sh.
STAGING_SSH=staging                     # ssh alias or user@host of the staging Mac
STAGING_LISTEN=0.0.0.0:11236             # the address the service listens on
STAGING_FLAGS=                           # more server flags, e.g. --trust-proxy behind a tunnel
STAGING_SANDBOX=                         # 1 runs the OpenShell gateway beside the service (docs/deploy.md)
STAGING_GATEWAY_PORT=17671               # the gateway's port on the box's loopback
