        "bare.yaml": "\n"
      }
    },
    {
      "name": "-i writes a multi-line string",
      "args": [
        "-i",
        ". = \"a\\nb\"",
        "bare.yaml"
      ],
      "files": {
        "bare.yaml": "hello\n"
      },
      "stdout": "",
      "exit": 0,
      "written": {
        "bare.yaml": "a\nb\n"
      }
    },
    {
      "name": "-i on documents ending in an empty string",
      "args": [
        "-i",
        ".",
        "m.yaml"
      ],
      "files": {
        "m.yaml": "a: 1\n---\n\"\"\n"
      },
      "stdout": "",
      "exit": 0,
      "written": {
        "m.yaml": "a: 1\n---\n\n"
      }
    },
    {
      "name": "-i on documents ending in a --- string",
      "args": [
        "-i",
        ".",
        "m.yaml"
      ],
      "files": {
        "m.yaml": "a: 1\n---\n\"---\"\n"
      },
      "stdout": "",
      "exit": 0,
      "written": {
        "m.yaml": "a: 1\n---\n---\n"
      }
    },
    {
      "name": "-i on documents ending in a multi-line string",
      "args": [
        "-i",
        ".",
        "m.yaml"
      ],
      "files": {
        "m.yaml": "a: 1\n---\n|\n  x\n  y\n"
      },
      "stdout": "",
      "exit": 0,
      "written": {
        "m.yaml": "a: 1\n---\nx\ny\n\n"
      }
    },
    {
      "name": "-i keeps only the selected document, no leading ---",
      "args": [
        "-i",
        "select(.kind == \"Deployment\") | .spec.replicas = 5",
        "pods.yaml"
      ],
      "stdout": "",
      "exit": 0,
      "written": {
        "pods.yaml": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: web\nspec:\n  replicas: 5\n"
      }
    },
    {
      "name": "-i with a leading --- in the file",
      "args": [
        "-i",
        "select(.a == 2) | .b = 1",
        "m.yaml"
      ],
      "files": {
        "m.yaml": "---\na: 1\n---\na: 2\n"
      },
      "stdout": "",
      "exit": 0,
      "written": {
        "m.yaml": "a: 2\nb: 1\n"
      }
    },
    {
      "name": "-i sets a field in every document",
      "args": [
        "-i",
        ".metadata.labels.team = \"web\"",
        "flux.yaml"
      ],
      "stdout": "",
      "exit": 0,
      "written": {
        "flux.yaml": "apiVersion: helm.toolkit.fluxcd.io/v2\nkind: HelmRelease\nmetadata:\n  name: podinfo\n  namespace: apps\n  labels:\n    team: web\nspec:\n  interval: 10m\n  chart:\n    spec:\n      chart: podinfo\n      version: 6.7.0\n---\napiVersion: kustomize.toolkit.fluxcd.io/v1\nkind: Kustomization\nmetadata:\n  name: infra\n  namespace: flux-system\n  labels:\n    team: web\nspec:\n  interval: 1h\n  path: ./infrastructure\n  prune: true\n---\napiVersion: helm.toolkit.fluxcd.io/v2\nkind: HelmRelease\nmetadata:\n  name: redis\n  namespace: cache\n  labels:\n    team: web\nspec:\n  interval: 5m\nstatus:\n  conditions:\n    - type: Ready\n      status: \"False\"\n      reason: InstallFailed\n    - type: Released\n      status: \"True\"\n      reason: InstallSucceeded\n"
      }
    },
    {
      "name": "-p json keeps yaml output",
      "args": [
        "-p",
        "json",
        ".meta",
        "data.txt"
      ],
      "files": {
        "data.txt": "{\"meta\": {\"count\": 2}}\n"
      },
      "stdout": "count: 2\n",
      "exit": 0
    },
    {
      "name": "-p json on a json file keeps yaml output",
      "args": [
        "-p",
        "json",
        ".meta",
        "data.json"
      ],
      "stdout": "count: 2\n",
      "exit": 0
    },
    {
      "name": "-N over two files",
      "args": [
        "-N",
        ".kind",
        "pods.yaml",
        "flux.yaml"
      ],
      "stdout": "Pod\nPod\nDeployment\nHelmRelease\nKustomization\nHelmRelease\n",
      "exit": 0
    },
    {
      "name": "two files apart by ---",
      "args": [
        ".metadata.name",
        "list.yaml",
        "flux.yaml"
      ],
      "stdout": "null\n---\npodinfo\n---\ninfra\n---\nredis\n",
      "exit": 0
    },
    {
      "name": "-j over two files",
      "args": [
        "-j",
        ".kind",
        "list.yaml",
        "flux.yaml"
      ],
      "stdout": "\"List\"\n\"HelmRelease\"\n\"Kustomization\"\n\"HelmRelease\"\n",
      "exit": 0
    },
    {
      "name": "a yaml file then a json file",
      "args": [
        ".name",
        "config.yaml",
        "data.json"
      ],
      "stdout": "app\n---\napp\n",
      "exit": 0
    },
    {
      "name": "--unwrapScalar=false on a number",
      "args": [
        "--unwrapScalar=false",
        ".port",
        "config.yaml"
      ],
      "stdout": "8080\n",
      "exit": 0
    },
    {
      "name": "-e on an empty string",
      "args": [
        "-e",
        ".empty",
        "config.yaml"
      ],
      "stdout": "\n",
      "exit": 0
    },
    {
      "name": "a string inside a map keeps its quotes",
      "args": [
        ".metadata",
        "flux.yaml"
      ],
      "stdout": "name: podinfo\nnamespace: apps\n---\nname: infra\nnamespace: flux-system\n---\nname: redis\nnamespace: cache\n",
      "exit": 0
    }
  ]
}
